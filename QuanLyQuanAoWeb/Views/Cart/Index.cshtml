@model List<QuanLyQuanAoWeb.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
    var coupons = ViewBag.Coupons as List<QuanLyQuanAoWeb.Models.Coupon> ?? new();
    decimal subTotal = Model.Sum(item => item.Quantity * (item.Variant?.Product?.FinalPrice ?? 0));
}

<div class="container py-4 mb-5">
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-cart3 text-danger me-2"></i>GIỎ HÀNG CỦA BẠN</h3>
        <span class="badge bg-secondary ms-3">@Model.Sum(i => i.Quantity) sản phẩm</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            <!-- Danh sách sản phẩm trong giỏ -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th>Kích Cỡ / Màu</th>
                                    <th>Đơn Giá</th>
                                    <th style="width: 140px;">Số Lượng</th>
                                    <th>Thành Tiền</th>
                                    <th class="text-center pe-4"><i class="bi bi-trash"></i></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var product = item.Variant?.Product;
                                    var unitPrice = product?.FinalPrice ?? 0;
                                    var itemTotal = unitPrice * item.Quantity;

                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(product?.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=200" : product.MainImage)" 
                                                     class="rounded-3 me-3" 
                                                     style="width: 60px; height: 60px; object-fit: cover;" 
                                                     alt="@product?.ProductName">
                                                <div>
                                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@product?.ProductId" class="fw-bold text-dark text-decoration-none">
                                                        @product?.ProductName
                                                    </a>
                                                    <div class="small text-muted">SKU: @item.Variant?.SKU</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-dark">@item.Variant?.Size?.SizeName</span>
                                            <span class="badge" style="background-color: @(item.Variant?.Color?.ColorHex ?? "#666"); color: #fff;">
                                                @item.Variant?.Color?.ColorName
                                            </span>
                                        </td>
                                        <td class="fw-semibold">@unitPrice.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@(item.Variant?.StockQuantity ?? 99)" 
                                                       class="form-control form-control-sm text-center me-1" style="width: 65px;" onchange="this.form.submit()">
                                            </form>
                                        </td>
                                        <td class="fw-bold text-danger">@itemTotal.ToString("N0") đ</td>
                                        <td class="text-center pe-4">
                                            <form asp-action="RemoveItem" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm border-0">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                        <i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Tóm tắt Đơn Hàng & Khuyến Mãi -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm Tắt Đơn Hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền hàng tạm tính:</span>
                        <span class="fw-semibold">@subTotal.ToString("N0") đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                        <span class="fs-4 fw-bold text-danger">@subTotal.ToString("N0") đ</span>
                    </div>

                    <a href="#" class="btn btn-danger btn-lg w-100 fw-bold py-3 shadow-sm mb-3">
                        <i class="bi bi-credit-card me-2"></i>Tiến Hành Thanh Toán
                    </a>
                    <small class="text-muted text-center d-block">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i>Thanh toán an toàn & bảo mật
                    </small>
                </div>

                <!-- Danh sách Voucher Giảm Giá Khả Dụng -->
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                    <h6 class="fw-bold mb-2"><i class="bi bi-ticket-perforated-fill text-danger me-2"></i>Mã Giảm Giá Khả Dụng</h6>
                    @if (coupons.Any())
                    {
                        <div class="list-group list-group-flush small">
                            @foreach (var cp in coupons)
                            {
                                <div class="list-group-item bg-transparent px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-danger">@cp.CouponCode</span>
                                            <span class="ms-1 fw-bold">
                                                @(cp.DiscountPercent > 0 ? $"Giảm {cp.DiscountPercent}%" : $"Giảm {cp.DiscountAmount?.ToString("N0")} đ")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                        Đơn tối thiểu: @cp.MinOrderAmount.ToString("N0") đ - HSD: @cp.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 text-center my-5 rounded-4">
            <div class="mb-3 text-muted">
                <i class="bi bi-cart-x" style="font-size: 5rem;"></i>
            </div>
            <h4 class="fw-bold">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy lựa chọn cho mình những bộ trang phục ưng ý tại shop nhé.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 fw-bold mt-2">
                    <i class="bi bi-bag-check me-2"></i>Khám Phá Sản Phẩm Ngay
                </a>
            </div>
        </div>
    }
</div>
