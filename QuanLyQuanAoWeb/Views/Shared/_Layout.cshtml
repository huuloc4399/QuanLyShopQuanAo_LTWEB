<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUIT Uniform & Workwear</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="bg-navy text-white py-2 small border-bottom border-secondary border-opacity-25">
        <div class="container-fluid px-lg-5 d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-geo-alt-fill text-orange me-1"></i> 140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM</span>
                <span class="d-none d-md-inline text-white-50">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-clock-fill text-orange me-1"></i> Thứ 2 - Thứ 7: 8:00 - 18:00</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:02838161673" class="text-white text-decoration-none fw-semibold">
                    <i class="bi bi-telephone-fill text-orange me-1"></i> Hotline: 028 3816 1673
                </a>
                <span class="text-white-50">|</span>
                <a href="#contact-quote" class="text-white text-decoration-none">
                    <i class="bi bi-envelope-check-fill text-orange me-1"></i> dongphuc@huit.edu.vn
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-xl navbar-light py-2">
            <div class="container-fluid px-lg-5">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center text-decoration-none me-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="bg-navy text-white rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-shield-check text-orange fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bolder fs-4 lh-1 text-navy">HUIT<span class="text-orange">UNIFORM</span></div>
                        <small class="text-muted d-block" style="font-size: 0.68rem; letter-spacing: 0.5px; text-transform: uppercase;">Xưởng May Đồng Phục &amp; Đồ Bảo Hộ</small>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMainContent">
                    <!-- Nav Links matching Figma Design -->
                    <ul class="navbar-nav mx-auto mb-2 mb-xl-0 gap-xl-1">
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" asp-area="" asp-controller="Home" asp-action="Index">
                                Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" asp-area="" asp-controller="Home" asp-action="Products">
                                Sản Phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" href="/Home/Index#steps-process">
                                Quy Trình May
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" href="/Home/Index#pricing-packages">
                                Gói Báo Giá
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" asp-area="" asp-controller="Home" asp-action="News">
                                Cẩm Nang
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-navy fw-semibold px-2" asp-area="" asp-controller="Home" asp-action="Contact">
                                Liên Hệ
                            </a>
                        </li>
                    </ul>

                    <!-- Cart & User Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Compact Search Form -->
                        <form class="d-none d-xxl-block me-1" asp-area="" asp-controller="Home" asp-action="Products" method="get">
                            <div class="input-group input-group-sm">
                                <input class="form-control border-sand bg-warm" type="search" name="keyword" placeholder="Tìm mẫu áo..." style="width: 130px; font-size: 0.85rem;">
                                <button class="btn btn-outline-secondary border-sand bg-white text-navy" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </form>

                        <!-- Shopping Cart -->
                        <a class="btn btn-brand-outline-navy btn-sm px-3 py-2 d-flex align-items-center" asp-area="" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                            <i class="bi bi-cart3"></i>
                            <span class="ms-1 small fw-bold">Giỏ Hàng</span>
                        </a>

                        <!-- User Profile / Login -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                <a class="btn btn-brand-navy btn-sm px-3 py-2 fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1 text-orange"></i> Quản Trị
                                </a>
                            }
                            <div class="dropdown">
                                <button class="btn btn-light border-sand dropdown-toggle d-flex align-items-center fw-semibold py-2 px-3 btn-sm" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1 text-navy"></i>
                                    <span>@User.FindFirst("FullName")?.Value</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-sand">
                                    <li class="px-3 py-1 small text-muted">Quyền: <strong class="text-orange">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-light border-sand fw-semibold px-3 py-2 text-navy btn-sm" asp-area="" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person me-1"></i> Đăng nhập
                            </a>
                        }

                        <!-- Orange CTA Request Quote -->
                        <a asp-area="" asp-controller="Home" asp-action="Contact" class="btn btn-brand-orange btn-sm px-3 py-2 fw-semibold">
                            <i class="bi bi-file-earmark-text me-1"></i> Báo giá ngay
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Comprehensive Figma Footer -->
    <footer class="figma-footer pt-5 pb-3 mt-5">
        <div class="container pb-4">
            <div class="row g-4 justify-content-between">
                <!-- Col 1: Logo & Company Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-navy-light text-white rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-shield-check text-orange fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bolder fs-4 lh-1 text-white">HUIT<span class="text-orange">UNIFORM</span></div>
                            <small class="text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px; text-transform: uppercase;">Xưởng May Đồng Phục Doanh Nghiệp</small>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">
                        Chuyên sản xuất và cung ứng đồng phục doanh nghiệp, áo polo công sở, đồng phục nhà hàng, đồ bảo hộ lao động đạt chuẩn kiểm định an toàn kỹ thuật TCVN.
                    </p>
                    <div class="small text-white-50 mb-2">
                        <i class="bi bi-geo-alt-fill text-orange me-2"></i> 140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM
                    </div>
                    <div class="small text-white-50 mb-2">
                        <i class="bi bi-telephone-fill text-orange me-2"></i> Hotline đặt may: <strong>028 3816 1673</strong>
                    </div>
                    <div class="small text-white-50 mb-3">
                        <i class="bi bi-envelope-fill text-orange me-2"></i> Email: <strong>dongphuc@huit.edu.vn</strong>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-navy-light border border-secondary border-opacity-25 px-2 py-1"><i class="bi bi-check-circle-fill text-orange me-1"></i> ISO 9001:2015</span>
                        <span class="badge bg-navy-light border border-secondary border-opacity-25 px-2 py-1"><i class="bi bi-shield-fill-check text-orange me-1"></i> Chuẩn TCVN</span>
                    </div>
                </div>

                <!-- Col 2: Danh Mục Sản Phẩm -->
                <div class="col-lg-2 col-md-6">
                    <h6>DANH MỤC SẢN PHẨM</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Đồng phục công sở</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Products" asp-route-categoryId="1">Áo thun Polo sự kiện</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Products" asp-route-categoryId="3">Đồ bảo hộ & Áo phản quang</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Products" asp-route-categoryId="4">Đồng phục Nhà hàng - Cafe</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Products" asp-route-categoryId="5">Áo khoác gió & Mũ nón</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Products">Tất cả sản phẩm</a></li>
                    </ul>
                </div>

                <!-- Col 3: Về Chúng Tôi & Dịch Vụ -->
                <div class="col-lg-3 col-md-6">
                    <h6>VỀ CHÚNG TÔI & DỊCH VỤ</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a href="/Home/Index#about-factory">Giới thiệu năng lực xưởng may</a></li>
                        <li><a href="/Home/Index#steps-process">Quy trình đặt may 5 bước</a></li>
                        <li><a href="/Home/Index#pricing-packages">Gói dịch vụ cho doanh nghiệp</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="News">Cẩm nang & Báo chí may mặc</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">Chính sách bảo hành 1 đổi 1</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">Yêu cầu báo giá chi tiết</a></li>
                    </ul>
                </div>

                <!-- Col 4: Đăng Ký Nhận Mẫu Vải -->
                <div class="col-lg-3 col-md-6">
                    <h6>NHẬN MẪU VẢI MIỄN PHÍ</h6>
                    <p class="small text-white-50 mb-3">
                        Để lại email hoặc SĐT để nhận ngay bộ catalogue 20+ chất liệu vải may đồng phục thực tế tận nơi.
                    </p>
                    <form class="mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm bg-navy-light text-white border-secondary border-opacity-25" placeholder="Nhập email hoặc SĐT...">
                            <button class="btn btn-brand-orange btn-sm" type="button"><i class="bi bi-send-fill"></i></button>
                        </div>
                    </form>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-secondary btn-sm text-white rounded-circle p-1" style="width: 34px; height: 34px;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm text-white rounded-circle p-1" style="width: 34px; height: 34px;"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm text-white rounded-circle p-1" style="width: 34px; height: 34px;"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm text-white rounded-circle p-1" style="width: 34px; height: 34px;"><i class="bi bi-telephone-fill"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom pt-3 pb-2 text-center text-white-50 small">
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    Copyright &copy; 2026 <strong>HUIT UNIFORM & WORKWEAR</strong>. Đồ án Lập trình Web - Trường Đại học Công Thương TP.HCM.
                </div>
                <div class="d-flex gap-3">
                    <a href="#" class="text-white-50 text-decoration-none">Chính sách bảo mật</a>
                    <a href="#" class="text-white-50 text-decoration-none">Quy định đổi trả</a>
                    <a href="#" class="text-white-50 text-decoration-none">Cam kết chất lượng</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
