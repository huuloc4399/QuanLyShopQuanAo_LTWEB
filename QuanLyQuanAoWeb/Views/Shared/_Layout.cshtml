<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUIT Fashion Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f9fa;
            color: #212529;
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: 0.5px;
        }
        .badge-sale {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 2;
        }
        .product-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }
        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 px-3 text-center small">
        <span><i class="bi bi-truck me-1"></i> Miễn phí vận chuyển toàn quốc cho đơn hàng từ 500.000đ | Hotline: <strong>028 3816 1673</strong></span>
    </div>

    <!-- Main Navigation -->
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand text-dark fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-heart-fill text-danger me-1"></i>HUIT<span class="text-secondary fw-normal">FASHION</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Sản Phẩm Mới</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-fire me-1"></i>Khuyến Mãi
                            </a>
                        </li>
                    </ul>

                    <!-- Search Form -->
                    <form class="d-flex me-3 my-2 my-lg-0" asp-area="" asp-controller="Home" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="keyword" placeholder="Tìm quần áo, mã SP..." aria-label="Search" style="min-width: 220px;">
                            <button class="btn btn-outline-dark" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <!-- Cart Button -->
                    <a class="btn btn-outline-dark btn-sm me-3 position-relative px-3 fw-semibold" asp-area="" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3 me-1"></i>Giỏ Hàng
                    </a>

                    <!-- User Account / Cart -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-danger btn-sm text-white fw-bold px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i>Trang Quản Trị
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
                                    <span>@User.FindFirst("FullName")?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li class="px-3 py-1 small text-muted">Quyền: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark btn-sm me-2 fw-semibold px-3" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-dark btn-sm fw-semibold px-3" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3"><i class="bi bi-bag-heart-fill text-danger me-2"></i>HUIT FASHION</h5>
                    <p class="text-light small">
                        Hệ thống Website Quản Lý & Kinh Doanh Quần Áo Thời Trang. Đồ án môn học Lập trình Web - Trường Đại học Công Thương TP. Hồ Chí Minh.
                    </p>
                    <p class="text-light small mb-1"><i class="bi bi-geo-alt me-2 text-danger"></i>140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM</p>
                    <p class="text-light small mb-1"><i class="bi bi-telephone me-2 text-danger"></i>028 3816 1673</p>
                    <p class="text-light small"><i class="bi bi-envelope me-2 text-danger"></i>huitfashion@shopquanao.vn</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Danh Mục</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Áo thun & Polo</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Áo sơ mi Oxford</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Quần Jean Slimfit</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Quần Tây Âu</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Áo khoác gió</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Thành Viên Dự Án (Nhóm 4)</h6>
                    <ul class="list-unstyled small text-light">
                        <li class="mb-1"><span class="badge bg-primary me-1">Người 1</span> Database & Backend Nền tảng</li>
                        <li class="mb-1"><span class="badge bg-info text-dark me-1">Người 2</span> Figma & Frontend Layout</li>
                        <li class="mb-1"><span class="badge bg-success me-1">Người 3</span> Khách hàng & Đơn hàng + Word</li>
                        <li class="mb-1"><span class="badge bg-warning text-dark me-1">Người 4</span> Sản phẩm & Kho + PPT</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase mb-3">Chính Sách Bán Hàng</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Chính sách đổi trả trong 7 ngày</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Bảo hành đường chỉ trọn đời</a></li>
                        <li class="mb-2"><a href="#" class="text-light text-decoration-none">Hướng dẫn chọn size quần áo</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small text-light">
                &copy; 2026 - Đồ án Lập trình Web - Đại học Công Thương TP.HCM (HUIT). All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
