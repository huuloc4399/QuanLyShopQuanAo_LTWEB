@model QuanLyQuanAoWeb.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Thời Trang Quần Áo HUIT";
}

<!-- Hero Banner Section -->
<div class="bg-dark text-white py-5 mb-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-danger mb-3 px-3 py-2 text-uppercase fw-bold">Bộ Sưu Tập Mới 2026</span>
                <h1 class="display-4 fw-bold mb-3">Phong Cách Thời Trang Trẻ Trung & Thanh Lịch</h1>
                <p class="lead text-light mb-4">
                    Khám phá hàng trăm mẫu áo thun cotton, sơ mi Oxford, quần jean và áo khoác thời thượng với chất lượng vượt trội.
                </p>
                <div class="d-flex gap-2">
                    <a href="#product-list" class="btn btn-primary btn-lg px-4 fw-bold">
                        <i class="bi bi-bag-check me-2"></i>Mua sắm ngay
                    </a>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-speedometer2 me-2"></i>Vào Trang Admin
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?w=600" class="img-fluid rounded-4 shadow-lg" alt="Fashion Banner" style="max-height: 340px; object-fit: cover;">
            </div>
        </div>
    </div>
</div>

<div class="container" id="product-list">
    <!-- Danh mục Quick Links -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0"><i class="bi bi-grid-fill text-primary me-2"></i>Danh Mục Quần Áo</h4>
            <a asp-action="Index" class="text-decoration-none fw-semibold small">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg">
                    <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="text-decoration-none">
                        <div class="card border-0 shadow-sm text-center p-3 h-100 product-card @(Model.SelectedCategoryId == cat.CategoryId ? "border border-primary border-2" : "")">
                            <i class="bi bi-tag-fill text-primary fs-2 mb-2"></i>
                            <h6 class="fw-bold text-dark mb-1">@cat.CategoryName</h6>
                            <small class="text-muted">@cat.Products.Count sản phẩm</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Bộ lọc & Danh sách Sản phẩm -->
    <div class="row g-4">
        <!-- Sidebar Bộ Lọc -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-4 rounded-3 sticky-top" style="top: 80px;">
                <h5 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Bộ Lọc Tìm Kiếm</h5>
                <form asp-action="Index" method="get">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Từ khóa</label>
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên áo, quần...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Danh mục</label>
                        <select name="categoryId" class="form-select">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId" selected="@(Model.SelectedCategoryId == cat.CategoryId ? "selected" : null)">@cat.CategoryName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Khoảng giá (VNĐ)</label>
                        <div class="input-group mb-2">
                            <span class="input-group-text small">Từ</span>
                            <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control" placeholder="0">
                        </div>
                        <div class="input-group">
                            <span class="input-group-text small">Đến</span>
                            <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control" placeholder="1.000.000">
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark fw-bold">
                            <i class="bi bi-filter me-1"></i>Áp Dụng Lọc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Danh Sách Sản Phẩm -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-box-seam-fill text-danger me-2"></i>
                    Tất Cả Sản Phẩm <span class="text-muted fs-6 fw-normal">(@Model.AllProducts.Count sản phẩm)</span>
                </h4>
            </div>

            @if (Model.AllProducts.Any())
            {
                <div class="row g-4">
                    @foreach (var product in Model.AllProducts)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm product-card position-relative bg-white">
                                @if (product.DiscountPercent > 0)
                                {
                                    <span class="badge bg-danger badge-sale rounded-pill px-3 py-2">
                                        -@product.DiscountPercent%
                                    </span>
                                }
                                <a asp-action="Details" asp-route-id="@product.ProductId">
                                    <img src="@(string.IsNullOrEmpty(product.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500" : product.MainImage)" 
                                         class="card-img-top" 
                                         alt="@product.ProductName" 
                                         style="height: 260px; object-fit: cover;">
                                </a>
                                <div class="card-body d-flex flex-column p-3">
                                    <div class="text-muted small mb-1">
                                        <i class="bi bi-tag me-1"></i>@product.Category?.CategoryName
                                    </div>
                                    <h6 class="card-title fw-bold text-dark mb-2 text-truncate" title="@product.ProductName">
                                        <a asp-action="Details" asp-route-id="@product.ProductId" class="text-dark text-decoration-none">
                                            @product.ProductName
                                        </a>
                                    </h6>
                                    
                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fw-bold text-danger fs-5">@product.FinalPrice.ToString("N0") đ</span>
                                            @if (product.DiscountPercent > 0)
                                            {
                                                <small class="text-decoration-line-through text-muted ms-1">@product.Price.ToString("N0") đ</small>
                                            }
                                        </div>
                                        <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                            Chi tiết <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 mb-2"></i>
                    <h5>Không tìm thấy sản phẩm nào phù hợp!</h5>
                    <p class="small">Vui lòng thử lại với từ khóa hoặc bộ lọc khác.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-dark btn-sm">Xem tất cả sản phẩm</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
