            </div>
            <div class="col-6 col-md-4 col-lg d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-palette-fill text-orange fs-5"></i>
                <span class="small fw-bold text-navy">Bền màu trên 100 lần giặt</span>
            </div>
            <div class="col-6 col-md-4 col-lg d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-shield-check text-orange fs-5"></i>
                <span class="small fw-bold text-navy">Đạt chuẩn TCVN An toàn</span>
            </div>
            <div class="col-12 col-md-4 col-lg d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-arrow-repeat text-orange fs-5"></i>
                <span class="small fw-bold text-navy">Bảo hành 1 đổi 1 tận nơi</span>
            </div>
        </div>
    </div>
</div>

<!-- ================= 3. ABOUT FACTORY CAPABILITY BANNER ================= -->
