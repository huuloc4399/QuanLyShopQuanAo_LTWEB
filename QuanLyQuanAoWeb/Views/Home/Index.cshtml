        <div class="bg-white rounded-4 p-4 p-lg-5 border border-sand shadow-sm">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="badge-brand-orange mb-2 d-inline-block">NĂNG LỰC SẢN XUẤT KHÉP KÍN</span>
                    <h2 class="fw-bold text-navy mb-3">Quy trình dệt may &amp; in thêu công nghệ cao</h2>
                    <p class="text-muted mb-4">
                        Sở hữu dây chuyền cắt tự động, xưởng may 500+ máy may điện tử hiện đại cùng phân xưởng thêu vi tính Tajima Nhật Bản và in kỹ thuật số công nghệ cao, HUIT Uniform đảm bảo độ bền, sắc nét và tính thẩm mỹ cao nhất trên từng sản phẩm xuất xưởng.
                    </p>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold text-navy mb-1">Thiết kế mẫu 3D miễn phí</h6>
                                    <small class="text-muted">Phối màu &amp; dựng demo logo trực quan</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold text-navy mb-1">May mẫu duyệt trước</h6>
                                    <small class="text-muted">Khách hàng cầm tận tay duyệt vải thực tế</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold text-navy mb-1">Thêu vi tính Tajima</h6>
                                    <small class="text-muted">Đường thêu dày dặn, không xơ xước</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold text-navy mb-1">Kiểm định KCS nghiêm ngặt</h6>
                                    <small class="text-muted">100% sản phẩm được cắt chỉ &amp; ủi phẳng</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row g-2">
                        <div class="col-6">
                            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=500&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-3 shadow-sm w-100" style="height: 180px; object-fit: cover;" alt="Phân xưởng may hiện đại">
                        </div>
                        <div class="col-6">
                            <img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=500&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-3 shadow-sm w-100" style="height: 180px; object-fit: cover;" alt="Chất liệu vải cao cấp">
                        </div>
                        <div class="col-12">
                            <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=800&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-3 shadow-sm w-100" style="height: 160px; object-fit: cover;" alt="Đội ngũ nhân viên thanh lịch">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= 4. FEATURED PRODUCTS & CATEGORIES ================= -->
<section class="py-5" id="featured-products">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-4">
            <span class="badge-brand-orange mb-2 d-inline-block">BẢNG CHỌN MẪU THEO YÊU CẦU</span>
            <h2 class="fw-bolder text-navy mb-2">Đồng phục cho mọi ngành nghề</h2>
            <p class="text-muted">Từ văn phòng công sở, chuỗi nhà hàng khách sạn đến phân xưởng nhà máy xí nghiệp</p>
        </div>

        <!-- Category Tabs Filter -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <a asp-action="Index" class="btn btn-sm @(!Model.SelectedCategoryId.HasValue ? "btn-brand-navy" : "btn-light border-sand text-navy") px-3 py-2 fw-semibold">
                Tất cả sản phẩm
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" 
                   class="btn btn-sm @(Model.SelectedCategoryId == cat.CategoryId ? "btn-brand-navy" : "btn-light border-sand text-navy") px-3 py-2 fw-semibold">
                    @cat.CategoryName
                </a>
            }
        </div>

        <!-- Product Grid -->
        <div class="row g-4">
            @if (Model.AllProducts.Any())
            {
                @foreach (var product in Model.AllProducts.Take(8))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="figma-product-card">
                            @if (product.DiscountPercent > 0)
                            {
                                <span class="discount-pill">-@product.DiscountPercent%</span>
                            }

                            <!-- Product Image Wrap -->
                            <div class="card-img-wrap">
                                <a asp-action="Details" asp-route-id="@product.ProductId">
                                    <img src="@(string.IsNullOrEmpty(product.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500" : product.MainImage)" 
                                         alt="@product.ProductName" 
                                         loading="lazy">
                                </a>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <span class="badge-brand-navy mb-2 align-self-start" style="font-size: 0.72rem;">
                                    @(product.Category?.CategoryName ?? "Đồng phục")
                                </span>
                                
                                <h6 class="fw-bold text-navy mb-1 text-truncate" title="@product.ProductName">
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="text-navy text-decoration-none">
                                        @product.ProductName
                                    </a>
                                </h6>
                                
                                <small class="text-muted mb-2 text-truncate" style="font-size: 0.8rem;">
                                    Mã SP: @(product.ProductCode ?? "SP-" + product.ProductId) | Chất vải cao cấp
                                </small>

                                <!-- Pricing & Actions -->
                                <div class="mt-auto pt-2 border-top border-sand d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-bold text-orange fs-6">@product.FinalPrice.ToString("N0") đ</div>
                                        @if (product.DiscountPercent > 0)
                                        {
                                            <small class="text-decoration-line-through text-muted" style="font-size: 0.75rem;">@product.Price.ToString("N0") đ</small>
                                        }
                                    </div>
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-brand-outline-navy btn-sm px-2 py-1">
                                        Chi tiết <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Không tìm thấy sản phẩm phù hợp.</p>
                    <a asp-action="Index" class="btn btn-brand-navy btn-sm">Xem tất cả sản phẩm</a>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-action="Index" class="btn btn-brand-outline-navy px-4 py-2 fw-semibold">
                Xem toàn bộ bộ sưu tập mẫu áo (@Model.AllProducts.Count sản phẩm) <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- ================= 5. NAVY HIGHLIGHT BANNER: SAFETY WEAR ================= -->
