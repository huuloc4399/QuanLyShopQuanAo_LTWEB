@model QuanLyQuanAoWeb.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Xưởng May Đồng Phục & Đồ Bảo Hộ Doanh Nghiệp HUIT";
}

<!-- ================= 1. HERO BANNER SECTION ================= -->
<section class="py-5 bg-warm border-bottom border-sand position-relative overflow-hidden">
    <div class="container py-3 py-lg-4">
        <div class="row align-items-center g-5">
            <!-- Hero Left Content -->
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 mb-3">
                    <span class="badge-brand-orange">
                        <i class="bi bi-award-fill me-1"></i> XƯỞNG MAY ĐỒNG PHỤC DOANH NGHIỆP UY TÍN
                    </span>
                    <span class="badge-brand-navy d-none d-sm-inline">
                        <i class="bi bi-shield-fill-check me-1"></i> Chuẩn TCVN
                    </span>
                </div>

                <h1 class="display-4 fw-bolder text-navy mb-3 lh-sm">
                    May đồng phục &amp;<br />
                    bảo hộ lao động<br />
                    <span class="text-orange">đúng chuẩn, chuyên nghiệp</span>
                </h1>

                <p class="lead text-muted mb-4" style="max-width: 600px; font-size: 1.15rem;">
                    Xưởng may trực tiếp tại TP.HCM với năng lực hơn 60.000 sản phẩm/tháng. Đảm bảo chất liệu vải bền đẹp, đường may tỉ mỉ, in thêu logo sắc nét và cam kết giao hàng đúng tiến độ cho doanh nghiệp.
                </p>

                <!-- Action CTA Buttons -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#contact-quote" class="btn btn-brand-orange btn-lg px-4 shadow-sm">
                        <i class="bi bi-file-earmark-text-fill me-2"></i> Nhận báo giá ngay
                    </a>
                    <a href="#featured-products" class="btn btn-brand-outline-navy btn-lg px-4">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Khám phá mẫu áo
                    </a>
                </div>

                <!-- 3 Key Metric Stats -->
                <div class="pt-3 border-top border-sand">
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="fw-bold fs-3 text-navy lh-1">1,500+</div>
                            <small class="text-muted">Doanh nghiệp tin chọn</small>
                        </div>
                        <div class="col-4 border-start border-sand ps-3">
                            <div class="fw-bold fs-3 text-navy lh-1">68,000+</div>
                            <small class="text-muted">Bộ quần áo / tháng</small>
                        </div>
                        <div class="col-4 border-start border-sand ps-3">
                            <div class="fw-bold fs-3 text-navy lh-1">12+</div>
                            <small class="text-muted">Năm kinh nghiệm</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Right Visual Showcase -->
            <div class="col-lg-5">
                <div class="position-relative">
                    <div class="rounded-4 overflow-hidden shadow-lg border border-sand bg-white p-2">
                        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&auto=format&fit=crop&q=80" 
                             alt="Xưởng may đồng phục chuyên nghiệp" 
                             class="img-fluid rounded-3 w-100" 
                             style="height: 380px; object-fit: cover;">
                    </div>
                    
                    <!-- Floating Badge 1: Quality Guarantee -->
                    <div class="position-absolute bg-white p-3 rounded-3 shadow border border-sand d-flex align-items-center gap-3" 
                         style="bottom: -20px; left: -15px; max-width: 260px;">
                        <div class="bg-orange text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-check2-circle fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-navy small">Chất lượng vải chuẩn</div>
                            <small class="text-muted" style="font-size: 0.78rem;">Không phai màu &amp; không xù lông</small>
                        </div>
                    </div>

                    <!-- Floating Badge 2: On-time Delivery -->
                    <div class="position-absolute bg-navy text-white p-2 px-3 rounded-pill shadow-sm d-flex align-items-center gap-2" 
                         style="top: 20px; right: -15px;">
                        <i class="bi bi-clock-history text-orange"></i>
                        <span class="small fw-semibold">Giao hàng đúng hẹn 100%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= 2. TRUST & CERTIFICATE TICKER BAR ================= -->
<div class="bg-white py-3 border-bottom border-sand">
    <div class="container">
        <div class="row g-3 text-center align-items-center">
