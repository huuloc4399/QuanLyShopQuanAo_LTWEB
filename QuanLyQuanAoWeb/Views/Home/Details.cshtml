@model QuanLyQuanAoWeb.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
    var relatedProducts = ViewBag.RelatedProducts as List<QuanLyQuanAoWeb.Models.Product> ?? new();
    var totalStock = Model.Variants.Sum(v => v.StockQuantity);
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none">@Model.Category?.CategoryName</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;">@Model.ProductName</li>
        </ol>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Ảnh Sản Phẩm -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                @if (Model.DiscountPercent > 0)
                {
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill fs-6">
                        GIẢM @Model.DiscountPercent%
                    </span>
                }
                <img src="@(string.IsNullOrEmpty(Model.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=700" : Model.MainImage)" 
                     class="img-fluid w-100" 
                     alt="@Model.ProductName" 
                     style="max-height: 520px; object-fit: cover;">
            </div>
        </div>

        <!-- Thông Tin Chi Tiết Sản Phẩm -->
        <div class="col-lg-6">
            <div class="ps-lg-3">
                <div class="text-muted small mb-1">
                    <span class="badge bg-light text-dark border me-2">Mã: @(Model.ProductCode ?? "N/A")</span>
                    <span class="badge bg-light text-dark border">Danh mục: @Model.Category?.CategoryName</span>
                    <span class="badge bg-success bg-opacity-10 text-success ms-1"><i class="bi bi-star-fill text-warning me-1"></i>5.0 (Đánh giá)</span>
                </div>

                <h2 class="fw-bold text-dark mt-2 mb-3">@Model.ProductName</h2>

                <!-- Giá -->
                <div class="p-3 bg-light rounded-3 mb-4 d-flex align-items-baseline gap-3">
                    <span class="fs-2 fw-bold text-danger">@Model.FinalPrice.ToString("N0") đ</span>
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="text-decoration-line-through text-muted fs-5">@Model.Price.ToString("N0") đ</span>
                        <span class="badge bg-danger">Tiết kiệm @((Model.Price - Model.FinalPrice).ToString("N0")) đ</span>
                    }
                </div>

                <!-- Mô tả -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2">Mô tả sản phẩm:</h6>
                    <p class="text-secondary leading-relaxed">
                        @Model.Description
                    </p>
                </div>

                <!-- Form Thêm Vào Giỏ Hàng -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4">
                    <div class="card border border-light-subtle rounded-3 p-3 mb-4 bg-white shadow-sm">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-palette-fill text-primary me-2"></i>Chọn Kích Cỡ & Màu Sắc:</h6>

                        @if (Model.Variants.Any(v => v.StockQuantity > 0))
                        {
                            <div class="mb-3">
                                <select name="variantId" class="form-select form-select-lg" required>
                                    @foreach (var variant in Model.Variants.Where(v => v.StockQuantity > 0))
                                    {
                                        <option value="@variant.VariantId">
                                            Size @variant.Size?.SizeName - Màu @variant.Color?.ColorName (Còn @variant.StockQuantity cái)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="w-25">
                                    <label class="form-label small fw-bold text-muted">Số lượng:</label>
                                    <input type="number" name="quantity" class="form-control form-control-lg text-center fw-bold" value="1" min="1" max="99">
                                </div>
                                <div class="w-75 d-flex align-items-end">
                                    <button type="submit" class="btn btn-dark btn-lg w-100 fw-bold shadow-sm py-2">
                                        <i class="bi bi-cart-plus me-2"></i>Thêm Vào Giỏ Hàng
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-circle me-1"></i>Sản phẩm tạm thời hết hàng trong kho.
                            </div>
                        }
                    </div>
                </form>

                <div class="border-top pt-3 text-muted small">
                    <div class="d-flex gap-4">
                        <span><i class="bi bi-shield-check text-success me-1"></i>Chính hãng 100%</span>
                        <span><i class="bi bi-arrow-repeat text-primary me-1"></i>Đổi trả 7 ngày</span>
                        <span><i class="bi bi-truck text-warning me-1"></i>Giao hàng toàn quốc</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Đánh giá Khách hàng (Reviews) -->
    <div class="mt-5 pt-4 border-top">
        <h4 class="fw-bold mb-3"><i class="bi bi-chat-heart text-danger me-2"></i>Đánh Giá Từ Khách Hàng</h4>
        @if (Model.Reviews.Any())
        {
            <div class="row g-3">
                @foreach (var rev in Model.Reviews.Where(r => r.IsApproved))
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-3 rounded-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>@(rev.User?.FullName ?? "Khách hàng")
                                </div>
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= rev.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                            </div>
                            <p class="text-secondary small mb-1">@rev.Comment</p>
                            <small class="text-muted" style="font-size: 0.75rem;">@rev.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
    </div>

    <!-- Sản Phẩm Liên Quan -->
    @if (relatedProducts.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h4 class="fw-bold mb-4"><i class="bi bi-stars text-warning me-2"></i>Sản Phẩm Cùng Danh Mục</h4>
            <div class="row g-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm product-card">
                            <a asp-action="Details" asp-route-id="@item.ProductId">
                                <img src="@(string.IsNullOrEmpty(item.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500" : item.MainImage)" 
                                     class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: cover;">
                            </a>
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-truncate mb-2">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">@item.ProductName</a>
                                </h6>
                                <div class="text-danger fw-bold">@item.FinalPrice.ToString("N0") đ</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
