@model QuanLyQuanAoWeb.Models.Product
@{
    ViewData["Title"] = Model.ProductName + " - HUIT Uniform & Workwear";
    var relatedProducts = ViewBag.RelatedProducts as List<QuanLyQuanAoWeb.Models.Product> ?? new();
    var totalStock = Model.Variants.Sum(v => v.StockQuantity);
}

<!-- ================= 1. BREADCRUMB & HEADER NAVY BANNER ================= -->
<div class="bg-navy text-white py-4 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small text-white-50">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-white-50 text-decoration-none">@(Model.Category?.CategoryName ?? "Sản phẩm")</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.ProductName</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold mb-0 text-white">@Model.ProductName</h1>
    </div>
</div>

<div class="container pb-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ================= 2. PRODUCT SHOWCASE (2 COLUMNS) ================= -->
    <div class="row g-5 mb-5">
        <!-- Cột Trái: Thư Viện Ảnh Sản Phẩm -->
        <div class="col-lg-6">
            <div class="position-sticky" style="top: 90px;">
                <!-- Ảnh Chính -->
                <div class="card border border-sand shadow-sm rounded-4 overflow-hidden position-relative bg-white mb-3">
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="discount-pill position-absolute top-0 start-0 m-3 px-3 py-2 fs-6">
                            -@Model.DiscountPercent%
                        </span>
                    }
                    <img id="mainProductImg" 
                         src="@(string.IsNullOrEmpty(Model.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=700" : Model.MainImage)" 
                         class="img-fluid w-100" 
                         alt="@Model.ProductName" 
                         style="height: 480px; object-fit: cover;">
                </div>

                <!-- 4 Thumbnail Ảnh Phụ -->
                <div class="row g-2">
                    <div class="col-3">
                        <div class="border border-sand rounded-3 overflow-hidden p-1 bg-white cursor-pointer" onclick="document.getElementById('mainProductImg').src=this.querySelector('img').src">
                            <img src="@(string.IsNullOrEmpty(Model.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=400" : Model.MainImage)" 
                                 class="img-fluid rounded-2 w-100" style="height: 80px; object-fit: cover;" alt="Mặt trước">
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border border-sand rounded-3 overflow-hidden p-1 bg-white cursor-pointer" onclick="document.getElementById('mainProductImg').src=this.querySelector('img').src">
                            <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=400&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-2 w-100" style="height: 80px; object-fit: cover;" alt="Góc nghiêng">
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border border-sand rounded-3 overflow-hidden p-1 bg-white cursor-pointer" onclick="document.getElementById('mainProductImg').src=this.querySelector('img').src">
                            <img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=400&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-2 w-100" style="height: 80px; object-fit: cover;" alt="Chất vải chi tiết">
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border border-sand rounded-3 overflow-hidden p-1 bg-white cursor-pointer" onclick="document.getElementById('mainProductImg').src=this.querySelector('img').src">
                            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&auto=format&fit=crop&q=80" 
                                 class="img-fluid rounded-2 w-100" style="height: 80px; object-fit: cover;" alt="Xưởng may">
                        </div>
                    </div>
                </div>

                <!-- Cam kết chất lượng dưới ảnh -->
                <div class="row g-2 mt-3 text-center">
                    <div class="col-4">
                        <div class="p-2 bg-warm rounded-3 border border-sand">
                            <i class="bi bi-shield-check text-orange fs-5 d-block mb-1"></i>
                            <span class="small fw-semibold text-navy" style="font-size: 0.78rem;">Chuẩn TCVN</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-warm rounded-3 border border-sand">
                            <i class="bi bi-rulers text-orange fs-5 d-block mb-1"></i>
                            <span class="small fw-semibold text-navy" style="font-size: 0.78rem;">May theo bảng size</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-warm rounded-3 border border-sand">
                            <i class="bi bi-arrow-repeat text-orange fs-5 d-block mb-1"></i>
                            <span class="small fw-semibold text-navy" style="font-size: 0.78rem;">Bảo hành 1 đổi 1</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Thông Tin Mua Hàng & Biến Thể -->
        <div class="col-lg-6">
            <div class="ps-lg-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge-brand-orange">@(Model.Category?.CategoryName ?? "Đồng Phục")</span>
                    <span class="badge-brand-navy">Mã: @(Model.ProductCode ?? "SP-" + Model.ProductId)</span>
                </div>

                <h2 class="fw-bolder text-navy mb-2">@Model.ProductName</h2>

                <!-- Đánh giá sao -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="text-warning">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <span class="small fw-bold text-navy">5.0</span>
                    <span class="text-muted small">| Đã cung ứng hơn 12.000 sản phẩm cho doanh nghiệp</span>
                </div>

                <!-- Bảng Giá -->
                <div class="p-3 bg-warm rounded-3 border border-sand mb-4 d-flex align-items-baseline gap-3">
                    <span class="fs-2 fw-bold text-orange">@Model.FinalPrice.ToString("N0") đ</span>
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="text-decoration-line-through text-muted fs-5">@Model.Price.ToString("N0") đ</span>
                        <span class="badge bg-danger">Tiết kiệm @((Model.Price - Model.FinalPrice).ToString("N0")) đ</span>
                    }
                </div>

                <!-- Khung Thông Số Nhanh (Figma Specification Box) -->
                <div class="card border border-sand rounded-3 p-3 mb-4 bg-sand bg-opacity-25">
                    <h6 class="fw-bold text-navy mb-2"><i class="bi bi-info-circle-fill text-orange me-2"></i>Quy cách sản phẩm:</h6>
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Chất liệu:</strong> Vải cao cấp mềm mát, không xù</div>
                        <div class="col-6"><strong>Kiểu dáng:</strong> Regular / Slim-fit hiện đại</div>
                        <div class="col-6"><strong>In / Thêu:</strong> Thêu vi tính Tajima sắc nét</div>
                        <div class="col-6"><strong>Quy mô may:</strong> Nhận may từ 20 đến 10.000+ bộ</div>
                    </div>
                </div>

                <!-- Form Thêm Vào Giỏ Hàng & Chọn Biến Thể -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4">
                    <div class="card border border-sand rounded-3 p-4 bg-white shadow-sm">
                        <h6 class="fw-bold text-navy mb-3"><i class="bi bi-palette-fill text-orange me-2"></i>Chọn Kích Cỡ &amp; Màu Sắc:</h6>

                        @if (Model.Variants.Any(v => v.StockQuantity > 0))
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-navy">Biến thể có sẵn trong kho:</label>
                                <select name="variantId" class="form-select border-sand bg-warm" required>
                                    @foreach (var variant in Model.Variants.Where(v => v.StockQuantity > 0))
                                    {
                                        <option value="@variant.VariantId">
                                            Size @variant.Size?.SizeName - Màu @variant.Color?.ColorName (Còn @variant.StockQuantity bộ có sẵn)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="row g-3 align-items-end mb-3">
                                <div class="col-sm-4">
                                    <label class="form-label small fw-bold text-navy">Số lượng:</label>
                                    <input type="number" name="quantity" class="form-control text-center fw-bold border-sand bg-warm" value="1" min="1" max="999">
                                </div>
                                <div class="col-sm-8">
                                    <button type="submit" class="btn btn-brand-orange w-100 py-2 fw-bold shadow-sm">
                                        <i class="bi bi-cart-plus-fill me-2"></i> Thêm Vào Giỏ Hàng
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-3">
                                <i class="bi bi-exclamation-circle me-1"></i>Sản phẩm tạm thời hết hàng sẵn kho. Vui lòng liên hệ để đặt xưởng may theo số lượng lớn.
                            </div>
                        }

                        <a href="#contact-quote" class="btn btn-brand-outline-navy w-100 py-2 fw-bold">
                            <i class="bi bi-file-earmark-text me-2"></i> Yêu cầu báo giá đặt may số lượng lớn (> 50 bộ)
                        </a>
                    </div>
                </form>

                <div class="border-top border-sand pt-3 text-muted small d-flex flex-wrap gap-4">
                    <span><i class="bi bi-truck text-orange me-1"></i> Giao hàng toàn quốc</span>
                    <span><i class="bi bi-shield-check text-orange me-1"></i> Đổi trả 1-1 nếu lỗi may</span>
                    <span><i class="bi bi-file-earmark-check text-orange me-1"></i> Hóa đơn VAT đầy đủ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 3. TABBED DESCRIPTION & SPECS ================= -->
    <div class="card border border-sand rounded-4 p-4 mb-5 bg-white shadow-sm">
        <ul class="nav nav-pills mb-4 border-bottom border-sand pb-3 gap-2" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active btn-brand-navy fw-semibold px-4" id="desc-tab" data-bs-toggle="pill" data-bs-target="#desc-pane" type="button" role="tab">
                    Mô tả chi tiết sản phẩm
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-light border-sand text-navy fw-semibold px-4" id="spec-tab" data-bs-toggle="pill" data-bs-target="#spec-pane" type="button" role="tab">
                    Thông số kỹ thuật &amp; Chất liệu
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-light border-sand text-navy fw-semibold px-4" id="policy-tab" data-bs-toggle="pill" data-bs-target="#policy-pane" type="button" role="tab">
                    Chính sách may mẫu &amp; Bảo hành
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-light border-sand text-navy fw-semibold px-4" id="review-tab" data-bs-toggle="pill" data-bs-target="#review-pane" type="button" role="tab">
                    Đánh Giá Từ Khách Hàng (@Model.Reviews.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="productTabsContent">
            <!-- Tab 1: Mô tả -->
            <div class="tab-pane fade show active" id="desc-pane" role="tabpanel">
                <h5 class="fw-bold text-navy mb-3">Đặc tính nổi bật của @Model.ProductName</h5>
                <p class="text-muted leading-relaxed mb-4">
                    @(string.IsNullOrEmpty(Model.Description) ? "Sản phẩm được gia công và sản xuất trực tiếp tại xưởng may HUIT Uniform với công nghệ may hai kim chắc chắn, đường chỉ tinh xảo, đáp ứng tiêu chuẩn khắt khe cho môi trường doanh nghiệp năng động và chuyên nghiệp." : Model.Description)
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-warm rounded-3 border border-sand">
                            <h6 class="fw-bold text-navy mb-1"><i class="bi bi-check-circle-fill text-orange me-2"></i>Độ bền màu vượt trội</h6>
                            <p class="small text-muted mb-0">Công nghệ nhuộm màu hoạt tính cao cấp giúp áo không phai màu, không lem khi giặt chung với các loại quần áo khác.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-warm rounded-3 border border-sand">
                            <h6 class="fw-bold text-navy mb-1"><i class="bi bi-check-circle-fill text-orange me-2"></i>Thoáng khí &amp; Khử mùi</h6>
                            <p class="small text-muted mb-0">Cấu trúc sợi dệt thoáng khí, hút ẩm tốt giúp người mặc luôn cảm thấy mát mẻ, tự tin suốt ngày dài làm việc.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Thông số kỹ thuật -->
            <div class="tab-pane fade" id="spec-pane" role="tabpanel">
                <h5 class="fw-bold text-navy mb-3">Thông số kỹ thuật vải</h5>
                <table class="table table-bordered border-sand">
                    <tbody>
                        <tr>
                            <th class="bg-warm text-navy w-25">Thành phần sợi vải</th>
                            <td>Cotton 100% / Kate Ý cao cấp / CVC 65/35 (tùy chọn)</td>
                        </tr>
                        <tr>
                            <th class="bg-warm text-navy">Định lượng vải</th>
                            <td>190g - 230g/m² (độ dày dặn chuẩn form dáng)</td>
                        </tr>
                        <tr>
                            <th class="bg-warm text-navy">Độ co giãn</th>
                            <td>Co giãn 4 chiều linh hoạt, thoải mái vận động</td>
                        </tr>
                        <tr>
                            <th class="bg-warm text-navy">Công nghệ in thêu</th>
                            <td>Thêu vi tính Tajima Nhật Bản độ phân giải cao / In decal nhiệt cao cấp</td>
                        </tr>
                        <tr>
                            <th class="bg-warm text-navy">Hướng dẫn bảo quản</th>
                            <td>Giặt máy ở chế độ thường, không dùng thuốc tẩy mạnh, phơi nơi râm mát</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Tab 3: Chính sách -->
            <div class="tab-pane fade" id="policy-pane" role="tabpanel">
                <h5 class="fw-bold text-navy mb-3">Chính sách đặt may số lượng lớn</h5>
                <ul class="text-muted leading-relaxed">
                    <li class="mb-2"><strong>Miễn phí may mẫu thật:</strong> Với đơn hàng từ 50 bộ, xưởng may 01 áo mẫu thực tế để quý khách kiểm duyệt trực tiếp chất liệu vải và độ sắc nét của logo.</li>
                    <li class="mb-2"><strong>Bảo hành 1 đổi 1 trong 30 ngày:</strong> Đổi mới miễn phí toàn bộ sản phẩm nếu phát hiện lỗi đường kim mũi chỉ hoặc sai lệch màu sắc so với mẫu đã duyệt.</li>
                    <li class="mb-2"><strong>Chiết khấu theo số lượng:</strong> Giảm giá trực tiếp từ 10% đến 25% cho các đơn hàng từ 100, 300, 500 đến 1.000+ bộ.</li>
                </ul>
            </div>

            <!-- Tab 4: Đánh Giá Từ Khách Hàng -->
            <div class="tab-pane fade" id="review-pane" role="tabpanel">
                <h5 class="fw-bold text-navy mb-3">Đánh Giá Từ Khách Hàng</h5>
                @if (Model.Reviews.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in Model.Reviews)
                        {
                            <div class="p-3 bg-warm rounded-3 border border-sand">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-navy">@(rev.User?.FullName ?? "Khách hàng doanh nghiệp")</strong>
                                    <div class="text-warning small">
                                        @for (int i = 0; i < rev.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </div>
                                </div>
                                <p class="small text-muted mb-1">@rev.Comment</p>
                                <small class="text-black-50" style="font-size: 0.75rem;">@rev.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small">Hiện chưa có đánh giá nào cho sản phẩm này.</p>
                }
            </div>
        </div>
    </div>

    <!-- ================= 4. FIGMA SIZE CHART TABLE ================= -->
    <div class="card border border-sand rounded-4 p-4 mb-5 bg-white shadow-sm">
        <div class="text-center max-w-700 mx-auto mb-4">
            <span class="badge-brand-orange mb-2 d-inline-block">THÔNG SỐ CHỌN SIZE</span>
            <h3 class="fw-bolder text-navy mb-1">Bảng thông số kích thước chuẩn (Size Chart)</h3>
            <p class="text-muted small">Thông số kích thước chuẩn dành cho vóc dáng người Việt Nam</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover text-center align-middle border border-sand mb-3">
                <thead class="bg-navy text-white">
                    <tr>
                        <th class="py-3">Size</th>
                        <th class="py-3">Chiều cao (cm)</th>
                        <th class="py-3">Cân nặng (kg)</th>
                        <th class="py-3">Vòng ngực (cm)</th>
                        <th class="py-3">Dài áo (cm)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">S</td>
                        <td>1m50 - 1m60</td>
                        <td>45 - 53 kg</td>
                        <td>88 - 92</td>
                        <td>65</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">M</td>
                        <td>1m60 - 1m68</td>
                        <td>53 - 62 kg</td>
                        <td>92 - 96</td>
                        <td>68</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">L</td>
                        <td>1m68 - 1m75</td>
                        <td>62 - 70 kg</td>
                        <td>96 - 100</td>
                        <td>71</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">XL</td>
                        <td>1m73 - 1m80</td>
                        <td>70 - 78 kg</td>
                        <td>100 - 106</td>
                        <td>74</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">XXL</td>
                        <td>1m78 - 1m85</td>
                        <td>78 - 88 kg</td>
                        <td>106 - 112</td>
                        <td>77</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-navy bg-warm">3XL</td>
                        <td>Trên 1m80</td>
                        <td>Trên 88 kg</td>
                        <td>112 - 118</td>
                        <td>80</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-muted small text-center mb-0">
            <i class="bi bi-info-circle text-orange me-1"></i> <em>Lưu ý: HUIT Uniform có hỗ trợ đội ngũ kỹ thuật đến tận văn phòng đo may theo số đo riêng cho từng nhân viên.</em>
        </p>
    </div>

    <!-- ================= 5. RELATED PRODUCTS ================= -->
    @if (relatedProducts.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="badge-brand-orange mb-1 d-inline-block">GỢI Ý CÙNG DANH MỤC</span>
                    <h3 class="fw-bolder text-navy mb-0">Sản phẩm liên quan</h3>
                </div>
                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-brand-outline-navy btn-sm px-3">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var prod in relatedProducts.Take(4))
                {
                    <div class="col-6 col-md-3">
                        <div class="figma-product-card">
                            @if (prod.DiscountPercent > 0)
                            {
                                <span class="discount-pill">-@prod.DiscountPercent%</span>
                            }
                            <div class="card-img-wrap">
                                <a asp-action="Details" asp-route-id="@prod.ProductId">
                                    <img src="@(string.IsNullOrEmpty(prod.MainImage) ? "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500" : prod.MainImage)" 
                                         alt="@prod.ProductName" loading="lazy">
                                </a>
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <span class="badge-brand-navy mb-2 align-self-start" style="font-size: 0.72rem;">
                                    @(prod.Category?.CategoryName ?? "Đồng phục")
                                </span>
                                <h6 class="fw-bold text-navy mb-2 text-truncate" title="@prod.ProductName">
                                    <a asp-action="Details" asp-route-id="@prod.ProductId" class="text-navy text-decoration-none">
                                        @prod.ProductName
                                    </a>
                                </h6>
                                <div class="mt-auto pt-2 border-top border-sand d-flex align-items-center justify-content-between">
                                    <div class="fw-bold text-orange">@prod.FinalPrice.ToString("N0") đ</div>
                                    <a asp-action="Details" asp-route-id="@prod.ProductId" class="btn btn-brand-outline-navy btn-sm px-2 py-1">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ================= 6. ORANGE CTA BANNER ================= -->
    <div class="cta-banner-orange d-flex flex-wrap align-items-center justify-content-between gap-4 mt-5">
        <div>
            <h3 class="fw-bold mb-2">Bạn có nhu cầu may mẫu áo này riêng cho doanh nghiệp?</h3>
            <p class="mb-0 text-white-50">Nhận ngay mẫu vải thực tế, bản vẽ phối màu 3D có gắn logo và bảng báo giá chiết khấu tận xưởng.</p>
        </div>
        <a asp-action="Index" asp-fragment="contact-quote" class="btn btn-navy text-white px-4 py-3 fw-bold shadow">
            <i class="bi bi-telephone-outbound-fill me-2 text-orange"></i> Nhận tư vấn báo giá ngay
        </a>
    </div>
</div>
