@model QuanLyQuanAoWeb.Models.ViewModels.ProductCatalogViewModel
@{
    ViewData["Title"] = "Sản Phẩm Đồng Phục & Bảo Hộ Lao Động";
}

<!-- Page Banner: Deep Navy Background -->
<section class="bg-navy text-white py-4 py-md-5 position-relative overflow-hidden">
    <div class="container-fluid px-lg-5">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active text-orange fw-bold" aria-current="page">Sản phẩm</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-6 fw-bolder text-white text-uppercase tracking-wide mb-2">
                    SẢN PHẨM ĐỒNG PHỤC &amp; BẢO HỘ LAO ĐỘNG
                </h1>
                <p class="text-white-50 lead fs-6 mb-0">
                    Đa dạng chủng loại, chất liệu may cao cấp, đạt chuẩn theo quy chuẩn doanh nghiệp &amp; an toàn lao động quốc gia.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-2 rounded-pill border border-white border-opacity-20 text-white small">
                    <i class="bi bi-patch-check-fill text-orange fs-5"></i>
                    <span>Hơn <strong>@Model.TotalCount</strong> mẫu đồng phục sẵn sàng may đo</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Search Bar -->
<section class="bg-warm border-bottom py-3 sticky-top shadow-xs" style="top: 57px; z-index: 990;">
    <div class="container-fluid px-lg-5">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <!-- Category Pills Filter -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-action="Products" asp-route-categoryId="" asp-route-keyword="@Model.SearchKeyword" asp-route-sortOrder="@Model.SortOrder"
                   class="btn btn-sm rounded-pill px-3 py-1 fw-semibold @(!Model.SelectedCategoryId.HasValue || Model.SelectedCategoryId == 0 ? "btn-navy shadow-sm" : "btn-outline-secondary bg-white text-navy border-sand")">
                    Tất cả
                </a>
                @foreach (var cat in Model.Categories)
                {
                    bool isSelected = Model.SelectedCategoryId == cat.CategoryId;
                    <a asp-action="Products" asp-route-categoryId="@cat.CategoryId" asp-route-keyword="@Model.SearchKeyword" asp-route-sortOrder="@Model.SortOrder"
                       class="btn btn-sm rounded-pill px-3 py-1 fw-semibold @(isSelected ? "btn-navy shadow-sm" : "btn-outline-secondary bg-white text-navy border-sand")">
                        @cat.CategoryName
                    </a>
                }
            </div>

            <!-- Search & Sort Controls -->
            <div class="d-flex align-items-center gap-2 ms-auto">
                <form asp-action="Products" method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                    <div class="input-group input-group-sm" style="min-width: 220px;">
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control border-sand" placeholder="Tìm kiếm mẫu áo...">
                        <button class="btn btn-navy" type="submit"><i class="bi bi-search"></i></button>
                    </div>

                    <select name="sortOrder" class="form-select form-select-sm border-sand" style="width: 140px;" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Nổi bật nhất</option>
                        <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá giảm dần</option>
                        <option value="name" selected="@(Model.SortOrder == "name")">Tên A-Z</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Main Products Section -->
<section class="py-5 bg-white">
    <div class="container-fluid px-lg-5">
        <!-- Section Title matching Figma -->
        <div class="text-center mb-5">
            <h2 class="section-title text-navy">Giải pháp cho mọi ngành nghề</h2>
            <p class="section-subtitle">Chúng tôi cung cấp các mẫu đồng phục tối ưu về công năng và nhận diện thương hiệu cho doanh nghiệp</p>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="text-center py-5 my-5">
                <div class="display-1 text-muted mb-3"><i class="bi bi-search"></i></div>
                <h4 class="text-navy fw-bold">Không tìm thấy sản phẩm phù hợp</h4>
                <p class="text-muted">Vui lòng thử lại với từ khóa hoặc danh mục khác.</p>
                <a asp-action="Products" class="btn btn-brand-orange mt-2">Xem tất cả sản phẩm</a>
            </div>
        }
        else
        {
            <!-- 8-Product Grid: 4 columns x 2 rows -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @for (int i = 0; i < Model.Products.Count; i++)
                {
                    var product = Model.Products[i];
                    string badgeText = i == 0 ? "BÁN CHẠY" : (i == 1 ? "MẪU MỚI" : (product.IsFeatured ? "TIÊU BIỂU" : "CHẤT LƯỢNG"));
                    string badgeBg = i == 0 ? "bg-orange" : (i == 1 ? "bg-success" : "bg-navy");

                    <div class="col">
                        <div class="card h-100 product-card border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column transition-hover">
                            <!-- Image Container -->
                            <div class="position-relative overflow-hidden bg-warm" style="padding-top: 100%;">
                                <img src="@product.MainImage" 
                                     alt="@product.ProductName" 
                                     class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover product-img-zoom"
                                     onerror="this.src='https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500&auto=format&fit=crop&q=80'">
                                <span class="badge @badgeBg text-white position-absolute top-0 start-0 m-2 px-2 py-1 small rounded-pill shadow-xs">
                                    @badgeText
                                </span>
                                @if (product.ProductCode != null)
                                {
                                    <span class="badge bg-white text-navy position-absolute bottom-0 end-0 m-2 px-2 py-1 small shadow-xs border">
                                        @product.ProductCode
                                    </span>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                <small class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    @(product.Category?.CategoryName ?? "Đồng phục")
                                </small>
                                <h6 class="card-title fw-bold text-navy mb-2 line-clamp-2" style="min-height: 2.6rem;">
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="text-navy text-decoration-none hover-orange">
                                        @product.ProductName
                                    </a>
                                </h6>

                                <!-- Rating & Specs -->
                                <div class="d-flex align-items-center justify-content-between mb-2 small">
                                    <div class="text-warning">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <span class="text-muted ms-1 text-xs">(5.0)</span>
                                    </div>
                                    <span class="text-muted text-xs"><i class="bi bi-eye text-navy me-1"></i>Đã may 1k+</span>
                                </div>

                                <!-- Price -->
                                <div class="mt-auto pt-2 border-top border-light d-flex align-items-baseline justify-content-between">
                                    <div>
                                        <span class="text-xs text-muted d-block">Giá tham khảo:</span>
                                        <span class="fw-bolder text-orange fs-6">
                                            @(product.Price > 0 ? $"{product.Price:N0} đ" : "Báo giá riêng")
                                        </span>
                                    </div>
                                    <span class="badge bg-light text-secondary border small">SL &ge; 20 cái</span>
                                </div>
                            </div>

                            <!-- Card Footer Action Buttons -->
                            <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-brand-navy btn-sm flex-grow-1 py-2 fw-semibold">
                                        <i class="bi bi-eye me-1"></i> Chi tiết
                                    </a>
                                    <a asp-action="Contact" class="btn btn-brand-outline-orange btn-sm px-3 py-2 fw-semibold" title="Nhận báo giá nhanh">
                                        <i class="bi bi-chat-dots-fill"></i> Báo giá
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Safety Wear Highlight Banner matching Figma Category design -->
        <div class="card bg-navy text-white rounded-4 border-0 p-4 p-lg-5 my-5 shadow overflow-hidden position-relative">
            <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
                <!-- Left Details -->
                <div class="col-lg-7">
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-3">
                        <i class="bi bi-shield-fill-check me-1"></i> TRANG THIẾT BỊ BẢO HỘ CHUYÊN DỤNG
                    </span>
                    <h3 class="display-6 fw-bold text-white mb-3">
                        Trang thiết bị cho ngành lao động đặc thù &amp; nguy hiểm
                    </h3>
                    <p class="text-white-50 mb-4">
                        Giải pháp bảo vệ toàn diện người lao động trong môi trường xây dựng, hóa chất, cơ khí chế tạo và hầm lò theo tiêu chuẩn an toàn quốc tế.
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-white">Đạt chuẩn EN ISO 20471</strong>
                                    <small class="text-white-50">Kiểm định an toàn lao động quốc gia</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-white">Phản quang 3M siêu sáng</strong>
                                    <small class="text-white-50">Nhận diện rõ ràng trong đêm cự ly 300m</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-white">Mũ &amp; Kính bảo hộ ANSI</strong>
                                    <small class="text-white-50">Chống va đập mạnh, chống tia UV</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-orange fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-white">Vải chống tĩnh điện &amp; cào rách</strong>
                                    <small class="text-white-50">Kaki Pangrim Hàn Quốc dệt sợi carbon</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <a asp-action="Contact" class="btn btn-brand-orange px-4 py-3 fw-bold rounded-3 shadow">
                        <i class="bi bi-telephone-outbound-fill me-2"></i> Yêu cầu tư vấn thiết bị
                    </a>
                </div>

                <!-- Right Visual Showcase -->
                <div class="col-lg-5">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="bg-white rounded-3 p-3 text-center shadow-sm">
                                <img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?w=400&auto=format&fit=crop&q=80" 
                                     alt="Áo phản quang kỹ sư" 
                                     class="img-fluid rounded mb-2" 
                                     style="height: 160px; object-fit: cover;">
                                <div class="text-navy fw-bold small">Áo Phản Quang 3M</div>
                                <span class="badge bg-warning text-dark text-xs">TCVN 2622:1995</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-white rounded-3 p-3 text-center shadow-sm">
                                <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=400&auto=format&fit=crop&q=80" 
                                     alt="Mũ bảo hộ công trường" 
                                     class="img-fluid rounded mb-2" 
                                     style="height: 160px; object-fit: cover;">
                                <div class="text-navy fw-bold small">Nón Bảo Hộ ANSI</div>
                                <span class="badge bg-navy text-white text-xs">Chuẩn ANSI Z89.1</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Background Decorative Overlay -->
            <div class="position-absolute end-0 bottom-0 opacity-10 pointer-events-none d-none d-md-block" style="transform: translate(20%, 20%);">
                <i class="bi bi-shield-shaded" style="font-size: 20rem; color: white;"></i>
            </div>
        </div>

        <!-- Orange CTA Banner matching Figma -->
        <div class="card bg-orange text-white border-0 rounded-3 p-4 my-4 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white text-orange rounded-circle p-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 52px; height: 52px;">
                        <i class="bi bi-pencil-square fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white">Bạn cần thiết kế mẫu riêng theo yêu cầu của doanh nghiệp của bạn?</h5>
                        <p class="mb-0 text-white-50 small">Miễn phí 100% thiết kế demo 3D và gửi mẫu vải tận nơi trước khi tiến hành ký kết hợp đồng.</p>
                    </div>
                </div>
                <a asp-action="Contact" class="btn btn-navy text-white fw-bold px-4 py-2 rounded-3 shadow-xs">
                    Tư vấn miễn phí <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>
