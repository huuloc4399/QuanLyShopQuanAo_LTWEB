@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm p-5 border-0 rounded-3">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-lock" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - TRUY CẬP BỊ TỪ CHỐI</h2>
            <p class="text-muted mt-2">
                Bạn không có quyền truy cập vào trang quản trị này. Trang này chỉ dành cho tài khoản Quản trị viên (Admin) hoặc Nhân viên (Staff).
            </p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark me-2">
                    <i class="bi bi-house-door me-1"></i>Về trang chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-dark">
                    <i class="bi bi-person-circle me-1"></i>Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
