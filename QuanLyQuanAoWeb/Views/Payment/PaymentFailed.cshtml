@model QuanLyQuanAoWeb.Models.Order
@{
    ViewData["Title"] = "Thanh Toán Không Thành Công";
    var errorMsg = ViewBag.ErrorMessage as string ?? "Giao dịch thanh toán trực tuyến chưa hoàn tất.";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center mb-4 bg-white">
                <div class="mx-auto mb-3 text-warning">
                    <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">THANH TOÁN CHƯA HOÀN TẤT</h2>
                <div class="alert alert-warning border-0 bg-warning-subtle text-dark py-3 px-4 rounded-3 my-3">
                    <i class="bi bi-info-circle-fill text-warning me-2"></i>@errorMsg
                </div>

                @if (Model != null)
                {
                    <p class="text-muted mb-4 fs-6">
                        Đơn hàng của bạn đã được ghi nhận với mã <strong class="text-danger">@Model.OrderCode</strong> nhưng chưa được thanh toán thành công.
                        Hàng vẫn được hệ thống giữ chỗ trong 24 giờ. Bạn có thể chọn thử lại thanh toán hoặc chuyển sang nhận hàng trả tiền (COD).
                    </p>

                    <div class="d-inline-flex flex-wrap justify-content-center gap-3 p-3 bg-light rounded-3 mb-4 text-start">
                        <div>
                            <span class="text-muted d-block small">MÃ ĐƠN HÀNG</span>
                            <span class="fw-bold text-danger">@Model.OrderCode</span>
                        </div>
                        <div class="vr d-none d-sm-block"></div>
                        <div>
                            <span class="text-muted d-block small">TỔNG TIỀN</span>
                            <span class="fw-bold text-dark">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="vr d-none d-sm-block"></div>
                        <div>
                            <span class="text-muted d-block small">TRẠNG THÁI</span>
                            <span class="badge bg-danger">@Model.PaymentStatus</span>
                        </div>
                    </div>

                    <!-- Tùy chọn thanh toán lại -->
                    <div class="card border p-3 rounded-3 text-start mb-4">
                        <h6 class="fw-bold mb-3"><i class="bi bi-arrow-repeat text-danger me-2"></i>Chọn hình thức thanh toán tiếp tục:</h6>
                        <form asp-controller="Payment" asp-action="RetryPayment" method="post" class="d-flex flex-column gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.OrderId" />

                            <div class="form-check p-3 border rounded-3">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="COD" id="retryCod" checked />
                                <label class="form-check-label d-flex align-items-center justify-content-between w-100" for="retryCod">
                                    <span><strong>Thanh toán khi nhận hàng (COD)</strong> - Trả tiền mặt lúc giao hàng</span>
                                    <i class="bi bi-cash-stack text-success fs-5"></i>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded-3">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="VNPAY" id="retryVnpay" />
                                <label class="form-check-label d-flex align-items-center justify-content-between w-100" for="retryVnpay">
                                    <span><strong>Cổng VNPay Sandbox</strong> - Quét mã VNPAY-QR / ATM nội địa</span>
                                    <i class="bi bi-credit-card-2-front text-primary fs-5"></i>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded-3">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="MOMO" id="retryMomo" />
                                <label class="form-check-label d-flex align-items-center justify-content-between w-100" for="retryMomo">
                                    <span><strong>Ví MoMo Sandbox</strong> - Quét mã MoMo-QR / Ví MoMo</span>
                                    <i class="bi bi-wallet2 text-danger fs-5"></i>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-danger btn-lg fw-bold mt-2 py-2">
                                <i class="bi bi-check2-circle me-1"></i>Xác Nhận & Tiếp Tục
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-4 fs-6">
                        Đã có lỗi xảy ra trong quá trình kết nối với cổng thanh toán. Vui lòng kiểm tra lại giỏ hàng hoặc thử lại sau.
                    </p>
                    <div class="text-center">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-danger px-4 py-2">
                            <i class="bi bi-cart3 me-2"></i>Quay Lại Giỏ Hàng
                        </a>
                    </div>
                }

                <div class="text-center d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark px-4 py-2">
                        <i class="bi bi-house-door me-1"></i>Về Trang Chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
