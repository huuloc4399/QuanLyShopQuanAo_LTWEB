@model QuanLyQuanAoWeb.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container-fluid px-4">
    <h1 class="mt-4 text-danger">Xác nhận ngừng kinh doanh sản phẩm</h1>
    <h3 class="text-warning mb-4">Bạn có chắc chắn muốn ẩn/xóa mềm sản phẩm này không?</h3>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.MainImage))
                    {
                        <img src="@Model.MainImage" alt="" class="img-fluid rounded shadow" style="max-height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <p class="text-muted">Không có ảnh</p>
                    }
                </div>
                <div class="col-md-9">
                    <h4>@Model.ProductName</h4>
                    <hr />
                    <p><strong>Mã sản phẩm:</strong> @Model.ProductCode</p>
                    <p><strong>Danh mục:</strong> @Model.Category?.CategoryName</p>
                    <p><strong>Giá bán:</strong> <span class="text-danger font-weight-bold">@Model.Price.ToString("N0") đ</span></p>
                    <p><strong>Mô tả:</strong> @Model.Description</p>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="ProductId" />
                <button type="submit" class="btn btn-danger"><i class="fas fa-ban"></i> Xác nhận ẩn/xóa mềm</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ, quay lại danh sách</a>
            </form>
        </div>
    </div>
</div>