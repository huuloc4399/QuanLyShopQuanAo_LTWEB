@model QuanLyQuanAoWeb.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết sản phẩm</h1>
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center">
                    <img src="@Model.MainImage" alt="@Model.ProductName" class="img-fluid rounded shadow" style="max-height: 300px;" />
                </div>
                <div class="col-md-8">
                    <h3>@Model.ProductName</h3>
                    <hr />
                    <p><strong>Danh mục:</strong> @Model.ProductName</p>
                    <p><strong>Giá:</strong> <span class="text-danger font-weight-bold">@Model.Price.ToString("N0") VNĐ</span></p>
                    <p><strong>Mô tả:</strong> @Model.Description</p>
                </div>
            </div>
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning"><i class="fas fa-edit"></i> Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>